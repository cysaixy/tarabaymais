generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  FARMER     @map("farmer")
  TECHNICIAN @map("technician")
  OFFICER    @map("officer")

  @@map("user_role")
}

enum CropStatus {
  ACTIVE    @map("active")
  HARVESTED @map("harvested")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("crop_status")
}

enum ActivityType {
  PREPARATION  @map("preparation")
  PLANTING     @map("planting")
  FERTILIZER   @map("fertilizer")
  PEST_CONTROL @map("pest_control")
  IRRIGATION   @map("irrigation")
  HARVEST      @map("harvest")
  OTHER        @map("other")

  @@map("activity_type")
}

enum SeverityLevel {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")

  @@map("severity_level")
}

enum CaseStatus {
  SUBMITTED    @map("submitted")
  UNDER_REVIEW @map("under_review")
  INSPECTED    @map("inspected")
  RESOLVED     @map("resolved")
  REJECTED     @map("rejected")

  @@map("case_status")
}

enum ScanVerdict {
  HEALTHY  @map("healthy")
  FLAGGED  @map("flagged")

  @@map("scan_verdict")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @db.VarChar(128)
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  phone     String   @unique @db.VarChar(30)
  role      Role     @default(FARMER)
  fcmToken  String?  @map("fcm_token") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  farmerProfile     FarmerProfile?
  farms             Farm[]
  observations      Observation[]
  assignedCases     ExpertRequest[]  @relation("TechnicianCases")
  verifiedDisasters DisasterReport[] @relation("VerifiedDisasters")
  plantScans        PlantScan[]

  @@map("users")
}

model FarmerProfile {
  id                String   @id @default(uuid()) @db.VarChar(64)
  userId            String   @unique @map("user_id") @db.VarChar(128)
  rsbsaNumber       String?  @map("rsbsa_number") @db.VarChar(50)
  preferredLanguage String   @default("filipino") @map("preferred_language") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farmer_profiles")
}

model Farm {
  id           String   @id @default(uuid()) @db.VarChar(64)
  farmerId     String   @map("farmer_id") @db.VarChar(128)
  name         String   @db.VarChar(150)
  municipality String   @db.VarChar(100)
  barangay     String   @db.VarChar(100)
  areaHectares Decimal  @map("area_hectares") @db.Decimal(10, 2)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  farmer          User             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropCycles      CropCycle[]
  disasterReports DisasterReport[]

  @@index([farmerId, createdAt(sort: Desc)], map: "idx_farms_farmer_id_created_at_desc")
  @@map("farms")
}

model CropCycle {
  id                  String     @id @default(uuid()) @db.VarChar(64)
  farmId              String     @map("farm_id") @db.VarChar(64)
  cropType            String     @default("corn") @map("crop_type") @db.VarChar(50)
  variety             String?    @db.VarChar(100)
  plantingDate        DateTime   @map("planting_date") @db.Date
  expectedHarvestDate DateTime?  @map("expected_harvest_date") @db.Date
  areaHectares        Decimal    @map("area_hectares") @db.Decimal(10, 2)
  status              CropStatus @default(ACTIVE)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  farm         Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  activities   CropActivity[]
  observations Observation[]
  plantScans   PlantScan[]

  @@index([farmId, plantingDate(sort: Desc)], map: "idx_crop_cycles_farm_id_planting_date_desc")
  @@index([farmId, status], map: "idx_crop_cycles_farm_id_status")
  @@map("crop_cycles")
}

model CropActivity {
  id           String       @id @default(uuid()) @db.VarChar(64)
  cropCycleId  String       @map("crop_cycle_id") @db.VarChar(64)
  activityType ActivityType @map("activity_type")
  description  String       @db.Text
  costAmount   Decimal?     @map("cost_amount") @db.Decimal(10, 2)
  performedAt  DateTime     @map("performed_at") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([cropCycleId, performedAt(sort: Desc)], map: "idx_crop_activities_crop_cycle_id_performed_at_desc")
  @@map("crop_activities")
}

model Observation {
  id             String        @id @default(uuid()) @db.VarChar(64)
  cropCycleId    String        @map("crop_cycle_id") @db.VarChar(64)
  farmerId       String        @map("farmer_id") @db.VarChar(128)
  title          String        @db.VarChar(150)
  description    String        @db.Text
  imageUrl       String?       @map("image_url") @db.VarChar(500)
  aiDiagnosis    Json?         @map("ai_diagnosis")
  severity       SeverityLevel @default(LOW)
  scanId         String?       @map("scan_id") @db.VarChar(64) @unique
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(128) @unique
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  cropCycle     CropCycle      @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  farmer        User           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  expertRequest ExpertRequest?
  plantScan     PlantScan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([cropCycleId, createdAt(sort: Desc)], map: "idx_observations_crop_cycle_id_created_at_desc")
  @@index([farmerId], map: "idx_observations_farmer_id")
  @@index([scanId], map: "idx_observations_scan_id")
  @@index([severity, createdAt(sort: Desc)], map: "idx_observations_severity_created_at_desc")
  @@map("observations")
}

model ExpertRequest {
  id                   String     @id @default(uuid()) @db.VarChar(64)
  observationId        String     @unique @map("observation_id") @db.VarChar(64)
  assignedTechnicianId String?    @map("assigned_technician_id") @db.VarChar(128)
  status               CaseStatus @default(SUBMITTED)
  firstResponseAt      DateTime?  @map("first_response_at") @db.Timestamptz
  resolvedAt           DateTime?  @map("resolved_at") @db.Timestamptz
  recommendation       String?    @db.Text
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  observation        Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  assignedTechnician User?       @relation("TechnicianCases", fields: [assignedTechnicianId], references: [id])

  @@index([createdAt(sort: Desc)], map: "idx_expert_requests_created_at_desc")
  @@index([status, createdAt(sort: Desc)], map: "idx_expert_requests_status_created_at_desc")
  @@index([firstResponseAt], map: "idx_expert_requests_first_response_at")
  @@map("expert_requests")
}

model DisasterReport {
  id               String     @id @default(uuid()) @db.VarChar(64)
  farmId           String     @map("farm_id") @db.VarChar(64)
  disasterType     String     @map("disaster_type") @db.VarChar(50)
  damagePercentage Decimal    @map("damage_percentage") @db.Decimal(5, 2)
  estimatedLoss    Decimal?   @map("estimated_loss") @db.Decimal(12, 2)
  status           CaseStatus @default(SUBMITTED)
  verifiedById     String?    @map("verified_by_id") @db.VarChar(128)
  notes            String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  farm       Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VerifiedDisasters", fields: [verifiedById], references: [id])

  @@index([createdAt(sort: Desc)], map: "idx_disaster_reports_created_at_desc")
  @@index([farmId], map: "idx_disaster_reports_farm_id")
  @@map("disaster_reports")
}

model PlantScan {
  id            String        @id @default(uuid()) @db.VarChar(64)
  cropCycleId   String?       @map("crop_cycle_id") @db.VarChar(64)
  farmerId      String        @map("farmer_id") @db.VarChar(128)
  rawResult     Json          @map("raw_result")
  diagnosis     String?       @map("diagnosis") @db.VarChar(255)
  confidence    Decimal?      @map("confidence") @db.Decimal(5, 4)
  severity      SeverityLevel? @map("severity")
  verdict       ScanVerdict   @default(FLAGGED) @map("verdict")
  scanId        String?       @unique @map("scan_id") @db.VarChar(64)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  farmer      User       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  observation Observation?

  @@index([createdAt(sort: Desc)], map: "idx_plant_scans_created_at_desc")
  @@index([farmerId], map: "idx_plant_scans_farmer_id")
  @@index([cropCycleId], map: "idx_plant_scans_crop_cycle_id")
  @@index([verdict, createdAt(sort: Desc)], map: "idx_plant_scans_verdict_created_at_desc")
  @@map("plant_scans")
}

model KnowledgeChunk {
  id        String   @id @default(uuid()) @db.VarChar(64)
  title     String   @db.VarChar(255)
  source    String   @db.VarChar(255)
  category  String   @db.VarChar(100)
  content   String   @db.Text
  embedding Unsupported("vector(768)")?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([embedding], map: "idx_knowledge_chunks_embedding_hnsw")
  @@map("knowledge_chunks")
}
